# Telegram Bot Token (обязательно)
TELEGRAM_TOKEN=ваш_токен_сюда
TELEGRAM_CHAT_ID=123456789

# JWT Secret Key (обязательно, минимум 32 символа)
SECRET_KEY=my-super-secret-key-for-jwt-change-me-in-production

# Для админ-панели
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Для RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Для прокси (Telegram через VPN) — закомментировано для локальной разработки
# Раскомментируйте на сервере
# ip:port - ваш прокси
# HTTP_PROXY=socks5://ip:port
# HTTPS_PROXY=socks5://ip:port
# ALL_PROXY=socks5://ip:port
# NO_PROXY=localhost,127.0.0.1,rabbitmq

#Доменное имя если имеется
#DOMAIN_NAME=example.com

# Database URL
# Вариант для внешней БД (раскомментируйте)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname